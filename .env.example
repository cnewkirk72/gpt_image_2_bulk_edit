# NEVER commit a real key. Set these in your host's env config (Vercel/Railway Variables).
OPENAI_API_KEY=sk-proj-REPLACE_WITH_A_FRESHLY_ROTATED_KEY
# Shared secret Claude sends as "Authorization: Bearer <token>". Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Alternative auth for clients that can't send headers: connector URL becomes /mcp/<secret>
MCP_PATH_SECRET=
# Public URL of this deployment (no trailing slash); auto-derived on Vercel
PUBLIC_BASE_URL=
# Auto-injected when you connect a Vercel Blob store (required on Vercel)
# BLOB_READ_WRITE_TOKEN=
